# ============================================
# Configuration du serveur
# ============================================
PORT=4000
NODE_ENV=development

# Origine(s) autorisée(s) à appeler l'API (séparées par une virgule si plusieurs)
# En local avec Live Server / VSCode par ex. : http://127.0.0.1:5500
# En production : https://votre-domaine.com
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ============================================
# Authentification admin
# ============================================
# Utilisés uniquement par "npm run seed" pour créer le 1er compte admin.
# Changez ces valeurs avant le premier lancement, puis retirez le mot de passe
# de ce fichier une fois le compte créé.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi-avant-le-premier-lancement

# Clé secrète utilisée pour signer les sessions (JWT).
# Générez une valeur aléatoire forte, par ex. avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# ============================================
# Envoi d'email (notification de nouvelle demande de devis)
# Laissez SMTP_HOST vide pour désactiver l'envoi réel (les demandes restent
# enregistrées en base et visibles dans l'admin, mais aucun email n'est envoyé).
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Studacom <no-reply@studacom.ga>
MAIL_TO=ogmbindustrie@gmail.com
